<section class="testimonials">
  <div class="container">
    <div class="section-title animate-in">
      <span class="label">{{ section.settings.label }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card animate-in" style="transition-delay: {{ forloop.index | times: 120 }}ms" {{ block.shopify_attributes }}>
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"{{ block.settings.text }}"</p>
          <div class="testimonial-author">
            {{ block.settings.author }}
            <span>{{ block.settings.bike }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recenze",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Stitek",
      "default": "Recenze"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Co rikaji nasi zakaznici"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Recenze",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text recenze"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Jmeno"
        },
        {
          "type": "text",
          "id": "bike",
          "label": "Motorka"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recenze",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "text": "Polepy vypadaji naprosto fantasticky. Presny strih, skvela kvalita materialu. Po roce na motorce stale jako nove.",
            "author": "Martin K.",
            "bike": "Yamaha MT-09"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Objednal jsem sadu na svoji KTM a aplikace byla hracka. Navod v baleni skvely, vysledek jeste lepsi.",
            "author": "Petr S.",
            "bike": "KTM 390 Duke"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Rychle doruceni, super komunikace a polepy drzi i po dvou sezonach na enduru v terenu. Doporucuji!",
            "author": "Jakub V.",
            "bike": "Honda CRF 450"
          }
        }
      ]
    }
  ]
}
{% endschema %}
