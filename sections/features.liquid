<section class="features">
  <div class="container">
    <div class="section-title animate-in">
      <span class="label">{{ section.settings.label }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-card animate-in" style="transition-delay: {{ forloop.index | times: 100 }}ms" {{ block.shopify_attributes }}>
          <div class="feature-icon">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vyhody",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Stitek",
      "default": "Proc my"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Proc nakupovat u nas"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Podnadpis",
      "default": "Nabizime profesionalni polepy s garanovanou kvalitou a rychlym dorucenim"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Vyhoda",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ikona (emoji)",
          "default": "🏍"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nazev"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Popis"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vyhody",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🎯",
            "title": "Presny strih",
            "text": "Kazdy polep je presne vyriznut podle modelu vasi motorky. Perfektni padnuti garantovano."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "💎",
            "title": "Premium vinyl",
            "text": "Pouzivame vyhradne 3M a Avery Dennison vinyl s odolnosti vuci UV zareni a poveternostnim vlivum."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "title": "Rychle doruceni",
            "text": "Odeslani do 48 hodin. Doprava zdarma u objednavek nad 1 500 Kc po cele CR."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🛡️",
            "title": "Zaruka 3-5 let",
            "text": "Garantujeme stalobarevnost a odolnost. Pokud nejste spokojeni, vracime penize."
          }
        }
      ]
    }
  ]
}
{% endschema %}
