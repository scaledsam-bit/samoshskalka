{% if section.settings.announcement_text != blank %}
  <div class="announcement-bar">
    {{ section.settings.announcement_text }}
  </div>
{% endif %}

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" height="44">
      {% else %}
        <span class="logo-accent">MOTO</span>STICKERS
      {% endif %}
    </a>

    <button class="menu-toggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="header-actions">
      <form action="/search" method="get" class="header-search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" placeholder="Hledat polepy..." aria-label="Hledat">
      </form>

      <a href="/cart" class="cart-link">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Text oznameni",
      "default": "Doprava zdarma nad 1 500 Kc | Garance kvality 3-5 let"
    }
  ]
}
{% endschema %}
