<section class="section container">
  <div class="section-title animate-in">
    <span class="label">{{ section.settings.label }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="products-grid">
    {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
      <div class="animate-in" style="transition-delay: {{ forloop.index | times: 80 }}ms">
        {% render 'product-card', product: product %}
      </div>
    {% else %}
      {% for i in (1..8) %}
        <div class="animate-in" style="transition-delay: {{ i | times: 80 }}ms">
          <div class="product-card">
            <div class="product-card-image">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card-info">
              <span class="product-card-vendor">MotoStickers</span>
              <h3 class="product-card-title">Ukazkovy polep {{ i }}</h3>
              <div class="product-card-price">od 990 Kc</div>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  {% if section.settings.show_view_all %}
    <div style="text-align: center; padding-top: 2.5rem;">
      <a href="{{ collections[section.settings.collection].url | default: '/collections/all' }}" class="btn btn-outline">
        Zobrazit vse
        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Doporucene produkty",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Stitek",
      "default": "Nase nabidka"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Nejprodavanejsi polepy"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Podnadpis",
      "default": "Vybirejte z nasich nejoblibenejsich designu pro vasi motorku"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekce"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pocet produktu",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Zobrazit tlacitko Zobrazit vse",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Doporucene produkty"
    }
  ]
}
{% endschema %}
