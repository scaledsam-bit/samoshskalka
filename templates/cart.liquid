<div class="cart-page container">
  <h1>Kosik</h1>

  {% if cart.item_count > 0 %}
    {% form 'cart', cart %}
      <div class="cart-layout">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <div class="cart-item-image">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
                {% endif %}
              </div>
              <div>
                <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p style="color: var(--color-text-muted); font-size: 0.82rem; margin-top: 0.3rem;">{{ item.variant.title }}</p>
                {% endunless %}
              </div>
              <div class="qty-controls">
                <button type="button" class="qty-minus" onclick="this.closest('.qty-controls').querySelector('input').stepDown(); this.closest('form').submit();" aria-label="Snizit">−</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Pocet">
                <button type="button" class="qty-plus" onclick="this.closest('.qty-controls').querySelector('input').stepUp(); this.closest('form').submit();" aria-label="Zvysit">+</button>
              </div>
              <div class="cart-item-price">{{ item.line_price | money }}</div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary">
          <h3>Souhrn objednavky</h3>
          <div class="cart-line">
            <span>Mezisouc</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-line">
            <span>Doprava</span>
            <span>Vypocita se pri platbe</span>
          </div>
          <div class="cart-total">
            <span>Celkem</span>
            <span class="amount">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-note">
            Dane a doprava se vypocitaji pri dokonceni objednavky.
          </p>
          <button type="submit" name="checkout" class="btn btn-add-to-cart">
            Pokracovat k platbe
          </button>
        </div>
      </div>
    {% endform %}
  {% else %}
    <div class="empty-state">
      <h2>Vas kosik je prazdny</h2>
      <p>Zda se, ze jste si jeste nic nevybrali. Prozkumejte nasi nabidku polepu.</p>
      <a href="/collections/all" class="btn btn-primary">
        Prozkoumat polepy
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  {% endif %}
</div>
