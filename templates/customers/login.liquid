<div class="container page-content" style="max-width: 480px;">
  <h1>Prihlaseni</h1>

  {% form 'customer_login' %}
    {{ form.errors | default_errors }}

    <div style="margin-bottom: 1.25rem;">
      <label for="email" style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 0.5rem;">Email</label>
      <input type="email" name="customer[email]" id="email" required
        style="width: 100%; padding: 0.75rem 1rem; background: var(--color-secondary); color: var(--color-text); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 1rem;">
    </div>

    <div style="margin-bottom: 1.5rem;">
      <label for="password" style="display: block; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 0.5rem;">Heslo</label>
      <input type="password" name="customer[password]" id="password" required
        style="width: 100%; padding: 0.75rem 1rem; background: var(--color-secondary); color: var(--color-text); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 1rem;">
    </div>

    <button type="submit" class="btn btn-add-to-cart">Prihlasit se</button>

    <p style="text-align: center; margin-top: 1.5rem; color: var(--color-text-muted); font-size: 0.875rem;">
      Jeste nemate ucet? <a href="/account/register" style="color: var(--color-primary);">Zaregistrujte se</a>
    </p>
  {% endform %}
</div>
